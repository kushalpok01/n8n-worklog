# ==========================================
# n8n Production & Deployment Configuration
# ==========================================

# Domain & Reverse Proxy
# Point your DNS A record to your server's public IP address.
# Caddy will automatically issue and renew a free Let's Encrypt SSL certificate.
DOMAIN_NAME=n8n.yourdomain.com

# PostgreSQL Configuration
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=n8n
POSTGRES_HOST_PORT=5433

# n8n General Configuration
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.yourdomain.com/
GENERIC_TIMEZONE=Asia/Kathmandu

# Security & Credentials
# Use a 32-character random string (e.g., node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
N8N_ENCRYPTION_KEY=replace_with_a_32_byte_random_hex_string
N8N_SECURE_COOKIE=true

# Environment settings
NODE_ENV=production

# ==========================================
# n8n Code Sandbox Service Configuration
# ==========================================
N8N_SANDBOX_VERSION=1.3.4
SANDBOX_API_KEY=replace_with_a_64_char_random_hex_string
SANDBOX_REGISTRATION_TOKEN=replace_with_a_64_char_random_hex_string
SANDBOX_RUNNER_KEY=replace_with_a_64_char_random_hex_string

# n8n Connection to Sandbox Service
N8N_INSTANCE_AI_SANDBOX_ENABLED=true
N8N_INSTANCE_AI_SANDBOX_PROVIDER=n8n-sandbox
N8N_SANDBOX_SERVICE_URL=http://sandbox-api:8080
N8N_SANDBOX_SERVICE_API_KEY=replace_with_same_sandbox_api_key_as_above

