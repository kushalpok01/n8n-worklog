      "id": "d7a8e1b2-1345-48ef-b59c-6a19f20e4b83",
      "name": "Fetch Branch Commits1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        3300,
        208
      ],
      "alwaysOutputData": true,
      "credentials": {
        "githubApi": {
          "id": "KVIGDScKFHKiUmeV",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const seen = new Set();\nconst uniqueCommits = [];\nconst settings = $('Settings1').item.json;\nconst repoName = settings.repoName || 'HrmBack';\nconst authorLogin = (settings.githubUsername || 'kushalpok01').toLowerCase();\nconst authorEmail = (settings.authorEmail || 'kushalpok01@gmail.com').toLowerCase();\n\nfunction isAuthor(c) {\n  if (!c || !c.commit) return false;\n  const login = (c.author?.login || c.committer?.login || '').toLowerCase();\n  const aEmail = (c.commit.author?.email || '').toLowerCase();\n  const cEmail = (c.commit.committer?.email || '').toLowerCase();\n  const aName = (c.commit.author?.name || '').toLowerCase();\n  const cName = (c.commit.committer?.name || '').toLowerCase();\n\n  if (authorLogin && (login === authorLogin || aEmail.startsWith(authorLogin) || cEmail.startsWith(authorLogin))) return true;\n  if (authorEmail && (aEmail === authorEmail || cEmail === authorEmail)) return true;\n  if (aEmail.includes('kushal') || cEmail.includes('kushal') || aName.includes('kushal') || cName.includes('kushal')) return true;\n  if (aEmail.includes('+kushal') || cEmail.includes('+kushal')) return true;\n  return false;\n}\n\nlet rawItems = [];\ntry {\n  rawItems = $('Fetch Branch Commits1').all();\n} catch (e) {\n  rawItems = $input.all();\n}\nif (!rawItems || rawItems.length === 0) {\n  rawItems = $input.all();\n}\n\nfor (const item of rawItems) {\n  const data = item.json;\n  if (!data) continue;\n  const list = Array.isArray(data) ? data : [data];\n  for (const c of list) {\n    if (!c || !c.sha || seen.has(c.sha)) continue;\n    if (isAuthor(c)) {\n      seen.add(c.sha);\n      uniqueCommits.push(c);\n    }\n  }\n}\n\nuniqueCommits.sort((a, b) => {\n  const dateA = new Date(b.commit?.committer?.date || b.commit?.author?.date || 0);\n  const dateB = new Date(a.commit?.committer?.date || a.commit?.author?.date || 0);\n  return dateA - dateB;\n});\n\nconst lines = uniqueCommits.map(c => {\n  const cleanMsg = (c.commit?.message || '').replace(/\\r?\\n+/g, ' — ').trim();\n  return `- [${repoName}] ${cleanMsg}`;\n});\n\nreturn [{\n  json: {\n    commitCount: uniqueCommits.length,\n    commitList: lines.join('\\n') || 'No commits today.',\n    commits: uniqueCommits\n  }\n}];"
      },
