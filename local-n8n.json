        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const doc = $('Get Existing Doc').item.json; const elements = doc.body?.content || []; const lastElement = elements[elements.length - 1]; const endIndex = lastElement ? (lastElement.endIndex - 1) : 1; const textToInsert = $('Format WhatsApp Message').item.json.whatsappMessage; const requests = []; if (endIndex > 1) { requests.push({ deleteContentRange: { range: { startIndex: 1, endIndex: endIndex } } }); } requests.push({ insertText: { location: { index: 1 }, text: textToInsert } }); return JSON.stringify({ requests }); })() }}"
